{% extends 'main/1cols.html.twig' %}

{% block content %}
    <div class="min-h-screen">
        <div class="flex items-center justify-center p-4">
            <div class="flex flex-col items-center text-center bg-white rounded-2xl shadow-lg p-8 w-lg">
                <div class="bg-green-500 rounded-full p-4 mb-5 flex items-center justify-center shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="60" height="60">
                        <path fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
                              d="M20 6 L9 17 L4 12" />
                    </svg>
                </div>
                <h1 class="text-2xl font-semibold text-gray-800 mb-2">
                    Rezervare realizată cu succes!
                </h1>
                <p class="text-gray-600 text-sm mb-6">
                    Rezervarea ta a fost confirmată. Vei primi un email cu detaliile rezervării.
                </p>
                <a href="{{ path('public_app_homepage') }}" class="bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-lg font-medium shadow-sm transition">
                    Mergi la pagina principală
                </a>
            </div>
        </div>
    </div>

{% endblock %}
