{% extends 'main/1cols.html.twig' %}

{% block content %}
    <div id="about" class="page active">
        <!-- Hero Section -->
        <section class="text-white py-20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <h1 class="text-5xl font-bold mb-6">Despre noi</h1>
                    <p class="text-xl text-white max-w-3xl mx-auto">Empowering communities and transforming lives through compassion, education, and sustainable development.</p>
                </div>
            </div>
        </section>

        <!-- Our Story -->
        <section class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid md:grid-cols-2 gap-12 items-center">
                    <div>
                        <h2 class="text-4xl font-bold text-gray-900 mb-6">Our Story</h2>
                        <p class="text-gray-600 mb-4 leading-relaxed">Founded in 2010, Hope Foundation began with a simple vision: to create lasting change in underserved communities. What started as a small group of volunteers has grown into a dynamic organization impacting thousands of lives.</p>
                        <p class="text-gray-600 leading-relaxed">We believe that every person deserves access to basic necessities, quality education, and opportunities to thrive. Through our dedicated team and passionate supporters, we've built schools, provided healthcare, and created sustainable livelihoods.</p>
                    </div>
                    <div class="bg-gradient-to-br from-green-100 to-indigo-100 rounded-2xl p-8 h-80 flex items-center justify-center">
                        <div class="text-center">
                            <div class="text-6xl font-bold text-green-600">15+</div>
                            <div class="text-xl text-gray-700 mt-2">Years of Impact</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Values -->
        <section class="py-16 bg-gray-50 min-h-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-4xl font-bold text-center text-gray-900 mb-12">Our Core Values</h2>
                <div class="grid md:grid-cols-3 gap-8">
                    <div class="bg-white rounded-xl p-8 shadow-md hover:shadow-xl transition">
                        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Compassion</h3>
                        <p class="text-gray-600">We lead with empathy and understanding, treating every individual with dignity and respect.</p>
                    </div>
                    <div class="bg-white rounded-xl p-8 shadow-md hover:shadow-xl transition">
                        <div class="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center mb-4">
                            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Integrity</h3>
                        <p class="text-gray-600">We operate with transparency and accountability in all our actions and decisions.</p>
                    </div>
                    <div class="bg-white rounded-xl p-8 shadow-md hover:shadow-xl transition">
                        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Innovation</h3>
                        <p class="text-gray-600">We embrace creative solutions to address complex challenges and drive lasting change.</p>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
