<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Scan Complete</title>
    <style>
        body {
            background: linear-gradient(45deg, #ff0000, #8b0000);
            color: white;
            font-family: 'Courier New', monospace;
            margin: 0;
            padding: 20px;
            text-align: center;
        }
        .container {
            background: rgba(0, 0, 0, 0.8);
            border: 3px solid #ff4444;
            border-radius: 10px;
            padding: 30px;
            max-width: 600px;
            margin: 50px auto;
            box-shadow: 0 0 20px rgba(255, 0, 0, 0.5);
        }
        h1 {
            color: #ff4444;
            text-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
            font-size: 2.5em;
            margin-bottom: 20px;
        }
        .warning-icon {
            font-size: 4em;
            margin: 20px 0;
            animation: pulse 1s infinite;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
        .message {
            background: #330000;
            padding: 15px;
            border-left: 4px solid #ff4444;
            margin: 20px 0;
            text-align: left;
        }
        .files-list {
            background: #1a0000;
            padding: 15px;
            margin: 15px 0;
            border-radius: 5px;
            text-align: left;
        }
        .countdown {
            font-size: 1.5em;
            color: #ff4444;
            margin: 20px 0;
        }
        .disclaimer {
            font-size: 0.8em;
            color: #888;
            margin-top: 30px;
            border-top: 1px solid #444;
            padding-top: 15px;
        }
        .button {
            background: #ff4444;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1.1em;
            margin: 10px;
        }
        .button:hover {
            background: #cc0000;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="warning-icon">⚠️</div>
    <h1>SYSTEM COMPROMISED</h1>

    <div class="message">
        <strong>SECURITY BREACH DETECTED</strong><br>
        Unauthorized access to system resources has been confirmed.
    </div>

    <div class="files-list">
        <strong>ACCESSED FILES:</strong><br>
        • Passwords.dat<br>
        • Browser History<br>
        • Personal Documents<br>
        • System Configuration<br>
        • Network Settings
    </div>

    <div class="countdown" id="countdown">
        System shutdown in: 60 seconds
    </div>

    <button class="button" onclick="restoreSystem()">🚨 EMERGENCY RESTORE</button>
    <button class="button" onclick="contactSupport()">📞 CONTACT SUPPORT</button>

    <div class="disclaimer">
        ⚠️ This is a simulated security awareness demonstration.
        No actual system files have been accessed or compromised.
        Always practice good cybersecurity habits!
    </div>
</div>

<script>
    let timeLeft = 60;
    const countdownElement = document.getElementById('countdown');

    const countdown = setInterval(() => {
        timeLeft--;
        countdownElement.textContent = `System shutdown in: ${timeLeft} seconds`;

        if (timeLeft <= 0) {
            clearInterval(countdown);
            countdownElement.textContent = "SYSTEM SHUTDOWN INITIATED";
            document.body.style.background = "#000000";
        }
    }, 1000);

    function restoreSystem() {
        clearInterval(countdown);
        countdownElement.textContent = "SYSTEM RESTORE IN PROGRESS...";
        countdownElement.style.color = "#00ff00";
        document.body.style.background = "linear-gradient(45deg, #008000, #004400)";

        setTimeout(() => {
            alert("✅ System restore complete! This was a security awareness test. Remember to:\n\n• Use strong passwords\n• Keep software updated\n• Be cautious with downloads\n• Use antivirus software");
        }, 2000);
    }

    function contactSupport() {
        alert("📞 Support Contact:\n\nThis is a simulated exercise.\nIn a real incident, contact your IT department immediately!");
    }
</script>
</body>
</html>
