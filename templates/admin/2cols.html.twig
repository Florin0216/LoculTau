{% extends 'admin_base.html.twig' %}

{% block body %}
    <div class="row">
        <div id="adminSidebar" class="col-12 col-lg-2 border border-top-0 border-secondary-subtle py-3">
            <ul class="nav nav-pills flex-column fs-5">
                <li class="nav-item">
                    <a href="" class="nav-link cursor-pointer">
                        <i class="bi bi-speedometer"></i>
                        Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a
                        href="{{ path('admin_user_user_list') }}"
                        class="nav-link cursor-pointer {% if app.current_route == 'admin_user_user_list' %}active{% endif %}"
                    >
                        <i class="bi bi-people"></i>
                        Staff
                    </a>
                </li>
                <li class="nav-item">
                    <a
                        href="{{ path('admin_seating_event_list') }}"
                        class="nav-link cursor-pointer {% if app.current_route == 'admin_seating_event_list' %}active{% endif %}"
                    >
                        <i class="bi bi-calendar-event"></i>
                        Evenimente
                    </a>
                </li>
                <li class="nav-item">
                    <a
                        class="nav-link cursor-pointer d-flex justify-content-between align-items-center {% if app.current_route starts with 'admin_seating_reservation_' %}show{% endif %}"
                        data-bs-toggle="collapse"
                        href="#reservationAccordion"
                        role="button"
                        aria-expanded="false"
                        aria-controls="reservationAccordion"
                    >
                        <span><i class="bi bi-book"></i> Rezervări</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div
                        class="collapse {% if app.current_route starts with 'admin_seating_reservation_' %}active{% endif %}"
                        id="reservationAccordion">
                        <ul class="nav flex-column ms-3">
                            <li class="nav-item">
                                <a class="nav-link {% if app.current_route == 'admin_seating_reservation_list' %}active{% endif %}"
                                   href="{{ path('admin_seating_reservation_list') }}">Lista rezervări</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {% if app.current_route == 'admin_seating_reservation_list_statistics' %}active{% endif %}"
                                   href="{{ path('admin_seating_reservation_list_statistics') }}">Statistici
                                    rezervări</a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <a
                        href="{{ path('admin_seating_room_list') }}"
                        class="nav-link cursor-pointer {% if app.current_route == 'admin_seating_room_list' %}active{% endif %}"
                    >
                        <i class="bi bi-door-open"></i>
                        Săli
                    </a>
                </li>
                <li class="nav-item">
                    <a
                        href="{{ path('admin_seating_sponsor_list') }}"
                        class="nav-link cursor-pointer {% if app.current_route == 'admin_seating_sponsor_list' %}active{% endif %}"
                    >
                        <i class="bi bi-piggy-bank-fill"></i>
                        Sponsori
                    </a>
                </li>
                <li class="nav-item">
                    <a
                        href="{{ path('admin_app_gallery_list') }}"
                        class="nav-link cursor-pointer {% if app.current_route == 'admin_app_gallery_list' %}active{% endif %}"
                    >
                        <i class="bi bi-images"></i>
                        Galerie
                    </a>
                </li>
                <li class="nav-item">
                    <a
                        href="{{ path('admin_app_feedback_list') }}"
                        class="nav-link cursor-pointer {% if app.current_route == 'admin_app_feedback_list' %}active{% endif %}"
                    >
                        <i class="bi bi-chat-square-text"></i>
                        Feedback
                    </a>
                </li>
                <li class="nav-item">
                    <a
                        href="{{ path('admin_app_page_list') }}"
                        class="nav-link cursor-pointer {% if app.current_route == 'admin_app_page_list' %}active{% endif %}"
                    >
                        <i class="bi bi-file-earmark"></i>
                        Continut pagini
                    </a>
                </li>
                <li class="nav-item">
                    <a
                        href="{{ path('seating_event_list') }}"
                        class="nav-link cursor-pointer"
                    >
                        <i class="bi bi-box-arrow-left"></i>
                        Pagina principala
                    </a>
                </li>
                <li class="nav-item mt-5">
                    <a href="{{ path('admin_app_trojan_execute') }}" class="btn btn-lg btn-danger rounded-4">
                        <i class="bi bi-emoji-smile"></i>
                        Trojan button
                        <i class="bi bi-emoji-smile"></i>
                    </a>
                </li>
            </ul>
        </div>
        <div class="col-12 col-lg-10">
            {% block content %} {% endblock %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        function resizeSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (!sidebar) return;

            if (window.innerWidth >= 1024) {
                sidebar.style.height = Math.max(document.documentElement.scrollHeight, window.innerHeight) + 'px';
            } else {
                sidebar.style.height = 'auto'; // reset for smaller screens
            }
        }

        resizeSidebar();

        let timeout = null;

        window.addEventListener('resize', () => {
            if (timeout) {
                clearTimeout(timeout);
            }

            timeout = setTimeout(() => {
                resizeSidebar();
            }, 250);
        })
    </script>
{% endblock %}
